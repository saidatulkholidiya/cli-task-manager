{
  "name": "cli-task-manager",
  "version": "1.0.0",
  "description": "Aplikasi pengelola tugas berbasis CLI",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && tsc-alias",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "clean": "powershell -Command \"Remove-Item -Recurse -Force dist\""
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsc-alias": "^1.8.10",
    "typescript": "^5.9.3"
  }
}
